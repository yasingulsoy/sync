# HospiSync Signage — gerekli ortam değişkenleri
#
# Bu dosya örnektir, gerçek değerleri içermez ve repoya girer.
# Kurulumda kopyalayıp doldurun:   cp .env.example .env
# Canlıda aynı değişkenleri Dokploy > Environment bölümüne girin.

# --- Uygulama ---------------------------------------------------------------

# Next.js'in dinleyeceği port (Dokploy genelde kendisi atar).
PORT="3000"


# --- Ekran paneli -----------------------------------------------------------

# /ekranlar sayfasının şifresi. Boş bırakılırsa panel kapalı kalır.
SIGNAGE_ADMIN_KEY=""


# --- PostgreSQL -------------------------------------------------------------
# İkisinden birini doldurmak yeterli: ya DATABASE_URL, ya alttaki parçalar.

# postgresql://KULLANICI:SIFRE@SUNUCU:5432/VERITABANI
DATABASE_URL=""

POSTGRES_HOST=""
POSTGRES_PORT="5432"
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# Uzak / yönetilen Postgres için "true", aynı Docker ağı içinse "false".
POSTGRES_SSL="false"
